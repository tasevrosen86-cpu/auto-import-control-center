# Publications publisher — server-side credentials.
#
# Install to /etc/aicc-publications.env with mode 600, owned by root:
#   sudo install -m 600 -o root -g root aicc-publications.env.example /etc/aicc-publications.env
#
# Nothing in this file is imported by the frontend. The publish engine reads it
# from the process environment only, so no key can reach the browser bundle or
# the build output.

# Real remote Chromium with stealth handling. Keys start with "bu_" and are
# created at https://cloud.browser-use.com/settings?tab=api-keys
# Without this the engine falls back to a local browser, which is measured to be
# blocked by Cloudflare for mobile.bg.
BROWSER_USE_API_KEY=

# Supabase. The anon key is sufficient: publication_* is granted and policied
# for it, so the service role key is deliberately not required here.
SUPABASE_URL=https://cgftjqwebvddtsbcbeml.supabase.co
SUPABASE_ANON_KEY=

# Mobile.bg listing constants. The phone is required by the form; the proven
# script hardcoded it and so do we, but as configuration rather than a literal.
PUBLICATIONS_CONTACT_PHONE=0887353653
PUBLICATIONS_DESCRIPTION=!!!реална крайна цена!!!

# Only set this to move the remote browser off the default endpoint.
# BROWSER_USE_API_BASE=https://api.browser-use.com
<?xml version="1.0" encoding="utf-8"?>
<!--
  AICC Mobile.

  The only permissions are internet access and the ability to read a picked
  image. Mobile.bg itself is opened inside the app's WebView, so no account
  credentials, no automation service and no background access are requested.
  usesCleartextTraffic stays off: every endpoint this app talks to is https.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AiccTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Serves the staged photos to the WebView's file chooser. Exported is
          false: only this app hands out these URIs, and each one is granted
          read access individually when the upload field is answered.
        -->
        <provider
            android:name=".PhotoProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>

</manifest>
